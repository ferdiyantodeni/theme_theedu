{{> theme_boost/head }}

{{{ theedu_dynamic_colors }}}

<body {{{ bodyattributes }}}>
<script>
    // Prevent Flash of Unstyled Content (FOUC) for Dark Mode
    (function() {
        var saved = localStorage.getItem('theedu_theme_mode');
        var def = '{{theedu_darkmode.default}}' || 'auto';
        var mode = saved ? saved : (def === 'dark' ? 'dark' : (def === 'light' ? 'light' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')));
        document.documentElement.setAttribute('data-theme', mode);
        document.body.setAttribute('data-theme', mode);
    })();
</script>

{{> core/local/toast/wrapper }}

<div id="page-wrapper" class="d-print-block {{#theedu_floating_header}}theedu-floating-header{{/theedu_floating_header}}">

    {{{ output.standard_top_of_body_html }}}

    {{! Custom TheEdu Navbar with Top-Left and Top-Right logos }}
    {{> theme_theedu/navbar }}

    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core_course{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-courseindex" data-toggle="tooltip" data-placement="right" title="{{#str}}opendrawerindex, core{{/str}}">
                            <span class="sr-only">{{#str}}opendrawerindex, core{{/str}}</span>
                            <i class="fa fa-bars fa-fw" aria-hidden="true"></i>
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button class="btn icon-no-margin" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-blocks" data-toggle="tooltip" data-placement="left" title="{{#str}}opendrawerblocks, core{{/str}}">
                            <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <i class="fa fa-chevron-left fa-fw" aria-hidden="true"></i>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>

            {{! 1. Standard Moodle Breadcrumbs & Header }}
            {{{ output.full_header }}}

            {{! 2. Secondary Navigation Tabs (Admin tabs, Course tabs) }}
            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none mb-3">
                    {{> core/moremenu}}
                </div>
            {{/secondarymoremenu}}

            {{! 3. TheEdu Modern Dashboard Hero Welcome Banner (Dashboard only - Inspired by Moove & Degrade) }}
            {{#is_dashboard}}
            <div class="theedu-dashboard-hero d-print-none mb-4">
                <div class="theedu-dashboard-hero-card">
                    <div class="row align-items-center g-3">
                        <div class="col-xl-7 col-lg-6">
                            <div class="d-flex align-items-center gap-3">
                                {{#user_avatar_html}}
                                <div class="theedu-hero-avatar-wrap flex-shrink-0">
                                    {{{ user_avatar_html }}}
                                </div>
                                {{/user_avatar_html}}
                                <div>
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                        <span class="theedu-pill-badge">
                                            <i class="fa fa-sparkles me-1"></i> {{user_role_label}}
                                        </span>
                                        {{#user_date}}
                                        <span class="theedu-hero-date text-muted small"><i class="fa fa-calendar-alt me-1"></i>{{user_date}}</span>
                                        {{/user_date}}
                                    </div>
                                    <h2 class="theedu-hero-title fw-bold mb-1">
                                        Selamat Datang kembali, <span class="theedu-hero-name">{{user_firstname}}</span>! 👋
                                    </h2>
                                    <p class="theedu-hero-desc text-muted mb-0 small">
                                        Pantau aktivitas pembelajaran, tugas, dan kursus aktif Anda di sini.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-5 col-lg-6 d-flex justify-content-lg-end justify-content-start">
                            <div class="theedu-dashboard-stats-grid d-flex flex-wrap gap-2">
                                <div class="theedu-stat-box">
                                    <div class="stat-number text-primary">{{user_course_count}}</div>
                                    <div class="stat-label">Terdaftar</div>
                                </div>
                                <div class="theedu-stat-box">
                                    <div class="stat-number text-success">{{user_completed_count}}</div>
                                    <div class="stat-label">Selesai</div>
                                </div>
                                <div class="theedu-stat-box">
                                    <div class="stat-number text-info">{{user_inprogress_count}}</div>
                                    <div class="stat-label">Berjalan</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/is_dashboard}}

            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">

                    <section id="region-main" aria-label="{{#str}}content{{/str}}">

                        {{#hasregionmainsettingsmenu}}
                        <div id="region-main-settings-menu" class="d-print-none">
                            <div> {{{ regionmainsettingsmenu }}} </div>
                        </div>
                        {{/hasregionmainsettingsmenu}}

                        {{{ output.course_content_header }}}

                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}

                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/url_select}}
                                </div>
                            </div>
                        {{/overflow}}

                        {{{ output.main_content }}}

                        {{! Modern TheEdu Course Activity Bottom Navigation Bar (Prev, Jump-To, Next) }}
                        {{#theedu_activity_nav.has_nav}}
                            {{> theme_theedu/activity_nav }}
                        {{/theedu_activity_nav.has_nav}}

                        {{{ output.course_content_footer }}}

                    </section>
                </div>
            </div>
        </div>

        {{#hasblocks}}
            {{< theme_boost/drawer }}
                {{$id}}theme_boost-drawers-blocks{{/id}}
                {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
                {{$drawercontent}}
                    <section class="d-print-none" aria-label="{{#str}}blocks{{/str}}">
                        {{{ addblockbutton }}}
                        {{{ sidepreblocks }}}
                    </section>
                {{/drawercontent}}
                {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
                {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
                {{$drawerstate}}show-drawer-right{{/drawerstate}}
                {{$tooltipplacement}}left{{/tooltipplacement}}
                {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
            {{/ theme_boost/drawer}}
        {{/hasblocks}}

    </div>

    {{! Custom TheEdu Footer with Bottom-Left and Bottom-Right logos }}
    {{> theme_theedu/footer }}

    {{{ output.standard_after_main_region_html }}}

</div>

{{{ output.standard_end_of_body_html }}}

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});

// Category view course card enhancements (Category Pill Tag Parity & Click Navigation)
(function() {
    function enrichCategoryCourseCards() {
        var catHeading = document.querySelector('#page-course-index-category .page-header-headings h1, .path-course-index .page-header-headings h1');
        var defaultCatName = catHeading ? catHeading.textContent.trim() : '';
        if (!defaultCatName) {
            var activeCrumb = document.querySelector('.breadcrumb-item.active, .breadcrumb .breadcrumb-item:last-child');
            if (activeCrumb) {
                defaultCatName = activeCrumb.textContent.trim();
            }
        }
        document.querySelectorAll('.coursebox').forEach(function(box) {
            if (!box.querySelector('.course-tag')) {
                var catName = defaultCatName;
                var boxCat = box.querySelector('.coursecat a, .category-name');
                if (boxCat && boxCat.textContent.trim()) {
                    catName = boxCat.textContent.trim();
                }
                if (catName) {
                    var tag = document.createElement('span');
                    tag.className = 'course-tag';
                    tag.textContent = catName;
                    box.appendChild(tag);
                }
            }

            // Make clicking card or arrow navigate to course
            if (!box.dataset.theeduClickAttached) {
                box.dataset.theeduClickAttached = 'true';
                box.addEventListener('click', function(e) {
                    if (e.target.closest('a') || e.target.closest('button')) {
                        return; // Let native links (e.g. teacher profile) work normally
                    }
                    var link = box.querySelector('.coursename a');
                    if (link && link.href) {
                        window.location.href = link.href;
                    }
                });
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enrichCategoryCourseCards);
    } else {
        enrichCategoryCourseCards();
    }
})();
{{/js}}
