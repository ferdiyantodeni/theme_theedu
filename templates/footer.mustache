{{!
    This file is part of Moodle - http://moodle.org/

    TheEdu Footer Template with Bottom-Left and Bottom-Right Logo positions.
}}
<footer id="page-footer" class="py-5">
    <div class="theedu-footer-inner container-fluid">

        <div class="theedu-footer-top row g-4">

            {{! 3. BOTTOM-LEFT LOGO & ABOUT COLUMN }}
            <div class="col-lg-5 col-md-6 theedu-logo-bottom-left">
                {{#theedu_logos.bottom_left.enabled}}
                    {{#theedu_logos.bottom_left.url}}
                        <a href="{{theedu_logos.bottom_left.link}}" aria-label="{{theedu_logos.bottom_left.alt}}">
                            <img src="{{theedu_logos.bottom_left.url}}" alt="{{theedu_logos.bottom_left.alt}}" style="height: {{theedu_logos.bottom_left.height}}px;">
                        </a>
                    {{/theedu_logos.bottom_left.url}}
                {{/theedu_logos.bottom_left.enabled}}

                {{#theedu_footer.about_text}}
                    <div class="footer-desc mt-2">
                        {{{ theedu_footer.about_text }}}
                    </div>
                {{/theedu_footer.about_text}}

                {{! Social Media Links }}
                <div class="theedu-social-links mt-3">
                    {{#theedu_footer.facebook}}
                        <a href="{{theedu_footer.facebook}}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Facebook">
                            <i class="fa fa-facebook"></i>
                        </a>
                    {{/theedu_footer.facebook}}
                    {{#theedu_footer.twitter}}
                        <a href="{{theedu_footer.twitter}}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="X Twitter">
                            <i class="fa fa-twitter"></i>
                        </a>
                    {{/theedu_footer.twitter}}
                    {{#theedu_footer.instagram}}
                        <a href="{{theedu_footer.instagram}}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
                            <i class="fa fa-instagram"></i>
                        </a>
                    {{/theedu_footer.instagram}}
                    {{#theedu_footer.youtube}}
                        <a href="{{theedu_footer.youtube}}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="YouTube">
                            <i class="fa fa-youtube-play"></i>
                        </a>
                    {{/theedu_footer.youtube}}
                    {{#theedu_footer.linkedin}}
                        <a href="{{theedu_footer.linkedin}}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
                            <i class="fa fa-linkedin"></i>
                        </a>
                    {{/theedu_footer.linkedin}}
                </div>
            </div>

            {{! QUICK LINKS OR INFORMATION COLUMN (CUSTOMIZABLE) }}
            <div class="col-lg-3 col-md-6 theedu-footer-col-middle">
                {{#theedu_footer.middle_title}}
                    <h5 class="fw-bold mb-3 footer-col-title" style="color: var(--theedu-primary, #6C5CE7);">{{{ theedu_footer.middle_title }}}</h5>
                {{/theedu_footer.middle_title}}
                {{#theedu_footer.has_middle_links}}
                <ul class="list-unstyled mb-0 theedu-footer-menu-links" style="line-height: 2.2;">
                    {{#theedu_footer.middle_links}}
                    <li>
                        <a href="{{url}}" class="text-decoration-none footer-link">
                            <i class="fa fa-angle-right me-2 text-muted"></i>{{{ title }}}
                        </a>
                    </li>
                    {{/theedu_footer.middle_links}}
                </ul>
                {{/theedu_footer.has_middle_links}}
            </div>

            {{! 4. BOTTOM-RIGHT LOGO & PARTNERSHIP / ACCREDITATION }}
            <div class="col-lg-4 col-md-12 theedu-logo-bottom-right">
                {{#theedu_logos.bottom_right.enabled}}
                    {{#theedu_logos.bottom_right.url}}
                        <div class="footer-partner-label mb-2">Supported & Certified By</div>
                        {{#theedu_logos.bottom_right.link}}<a href="{{theedu_logos.bottom_right.link}}" target="_blank" rel="noopener noreferrer">{{/theedu_logos.bottom_right.link}}
                            <img src="{{theedu_logos.bottom_right.url}}" alt="{{theedu_logos.bottom_right.alt}}" style="height: {{theedu_logos.bottom_right.height}}px;">
                        {{#theedu_logos.bottom_right.link}}</a>{{/theedu_logos.bottom_right.link}}
                    {{/theedu_logos.bottom_right.url}}
                {{/theedu_logos.bottom_right.enabled}}
            </div>

        </div>

        {{! Footer Bottom Bar }}
        <div class="theedu-footer-bottom">
            <div class="theedu-footer-bottom-main d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="theedu-copyright">
                    {{{ theedu_footer.copyright }}}
                </div>

                <div class="theedu-footer-bottom-actions d-flex flex-wrap align-items-center justify-content-md-end justify-content-center gap-3 gap-md-4">
                    {{#theedu_footer.custom_bottom_right}}
                        <div class="theedu-custom-bottom-links d-inline-flex flex-wrap align-items-center gap-3 gap-md-4">
                            {{#theedu_footer.bottom_links}}
                                <a href="{{url}}" class="footer-bottom-link">{{{ title }}}</a>
                            {{/theedu_footer.bottom_links}}
                            {{#theedu_footer.has_bottom_right_text}}
                                <span class="footer-bottom-custom-text">{{{ theedu_footer.bottom_right_text }}}</span>
                            {{/theedu_footer.has_bottom_right_text}}
                        </div>
                        {{#theedu_footer_lang.show_selector}}
                            <span class="theedu-footer-divider d-none d-md-inline-block" aria-hidden="true"></span>
                        {{/theedu_footer_lang.show_selector}}
                    {{/theedu_footer.custom_bottom_right}}

                    {{#theedu_footer_lang.show_selector}}
                    <div class="theedu-footer-lang-dropdown dropup d-inline-block">
                        <button class="btn btn-sm theedu-lang-drop-btn dropdown-toggle d-inline-flex align-items-center gap-2" type="button" id="theeduFooterLangDropdown" data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false" title="{{#str}}footer_language_select, theme_theedu{{/str}}">
                            <span class="theedu-lang-flag-box">{{{ theedu_footer_lang.current_flag_html }}}</span>
                            <span class="theedu-lang-current-name">{{theedu_footer_lang.current_name}}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end theedu-lang-menu shadow-lg" aria-labelledby="theeduFooterLangDropdown">
                            {{#theedu_footer_lang.languages}}
                            <li>
                                <a class="dropdown-item d-flex align-items-center justify-content-between gap-3 {{#active}}active{{/active}}" href="{{url}}">
                                    <span class="d-flex align-items-center gap-2 text-nowrap">
                                        <span class="theedu-lang-flag-box">{{{ flag_html }}}</span>
                                        <span class="theedu-lang-name">{{name}}</span>
                                    </span>
                                    {{#active}}
                                    <span class="theedu-lang-check-badge" aria-hidden="true" title="Active">
                                        <svg class="theedu-check-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    </span>
                                    {{/active}}
                                </a>
                            </li>
                            {{/theedu_footer_lang.languages}}
                        </ul>
                    </div>
                    {{/theedu_footer_lang.show_selector}}
                </div>
            </div>

            {{#theedu_footer.show_standard_footer}}
            <div class="theedu-footer-standard-row text-center mt-3 pt-3 border-top border-secondary border-opacity-10 small">
                {{{ output.standard_footer_html }}}
            </div>
            {{/theedu_footer.show_standard_footer}}
        </div>

    </div>
</footer>
