    TheEdu Login Page Template.
}}
{{> theme_boost/head }}

{{{ theedu_dynamic_colors }}}

<style>
/* Login Page Background & Viewport Layout (1-Screen Dynamic & Center Float) */
html, body.pagelayout-login {
    height: 100%;
    min-height: 100vh;
    margin: 0;
    padding: 0;
}
body.pagelayout-login {
    {{#theedu_login_bg}}
    background: linear-gradient(rgba(15, 23, 42, 0.42), rgba(15, 23, 42, 0.58)), url('{{{ theedu_login_bg }}}') center center / cover no-repeat fixed !important;
    {{/theedu_login_bg}}
    {{^theedu_login_bg}}
    background: linear-gradient(135deg, #1E1B4B 0%, #312E81 40%, #4338CA 70%, #6C5CE7 100%) center center / cover no-repeat fixed !important;
    {{/theedu_login_bg}}
    overflow-x: hidden;
}
body.pagelayout-login #page-wrapper {
    background: transparent !important;
    background-color: transparent !important;
    min-height: 100vh !important;
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 1.25rem 1rem !important;
    box-sizing: border-box !important;
}
.theedu-login-viewport {
    width: 100% !important;
    max-width: 440px !important;
    margin: auto !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
}
/* Floating Login Card in Center - Solid High Readability with Glass Aesthetics */
.theedu-login-card {
    width: 100% !important;
    background: rgba(255, 255, 255, 0.96) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border-radius: 1.5rem !important;
    border: 1px solid rgba(255, 255, 255, 0.6) !important;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.5) inset !important;
    padding: 2.25rem 2.25rem 1.75rem !important;
    box-sizing: border-box !important;
    position: relative !important;
    overflow: visible !important;
    text-align: left;
}
/* Logo at Top of Card */
.theedu-login-card .theedu-login-logo {
    text-align: center !important;
    margin-bottom: 1.25rem !important;
}
.theedu-login-card .theedu-login-logo img {
    max-height: 52px !important;
    max-width: 220px !important;
    height: auto !important;
    width: auto !important;
    object-fit: contain !important;
}
/* Reset any nested Moodle card/wrapper */
body.pagelayout-login .login-wrapper,
body.pagelayout-login .login-container,
body.pagelayout-login .theedu-login-card .card,
body.pagelayout-login .card {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    height: auto !important;
    min-height: auto !important;
    overflow: visible !important;
    transform: none !important;
}
body.pagelayout-login .theedu-login-card .card-body,
body.pagelayout-login .card-body {
    padding: 0 !important;
}
/* Title & Headings */
body.pagelayout-login h2,
body.pagelayout-login .login-heading {
    font-size: 1.35rem !important;
    font-weight: 700 !important;
    color: #0F172A !important;
    text-align: center !important;
    margin-bottom: 1.25rem !important;
    line-height: 1.3 !important;
}
/* Form Controls */
body.pagelayout-login .loginform {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
}
body.pagelayout-login .form-group {
    margin-bottom: 0.85rem !important;
}
body.pagelayout-login .form-control {
    border-radius: 0.75rem !important;
    padding: 0.75rem 1.1rem !important;
    font-size: 0.95rem !important;
    border: 1.5px solid #E2E8F0 !important;
    background-color: #F8FAFC !important;
    color: #0F172A !important;
    height: auto !important;
    transition: all 0.2s ease !important;
}
body.pagelayout-login .form-control:focus {
    background-color: #FFFFFF !important;
    border-color: var(--theedu-primary, #6C5CE7) !important;
    box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.2) !important;
}
/* Submit Button */
body.pagelayout-login .btn-primary,
body.pagelayout-login #loginbtn {
    width: 100% !important;
    border-radius: 2rem !important;
    padding: 0.75rem !important;
    font-weight: 700 !important;
    font-size: 1rem !important;
    background: linear-gradient(135deg, var(--theedu-primary, #6C5CE7), var(--theedu-secondary, #00CEC9)) !important;
    border: none !important;
    box-shadow: 0 8px 20px rgba(108, 92, 231, 0.3) !important;
    color: #FFFFFF !important;
    transition: all 0.25s ease !important;
    margin-top: 0.25rem !important;
}
body.pagelayout-login .btn-primary:hover,
body.pagelayout-login #loginbtn:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 25px rgba(108, 92, 231, 0.4) !important;
    color: #FFFFFF !important;
}
/* Forgot Password Link */
body.pagelayout-login .login-form-forgotpassword {
    text-align: center !important;
    margin-top: 0.75rem !important;
    margin-bottom: 0.5rem !important;
}
body.pagelayout-login .login-form-forgotpassword a {
    color: var(--theedu-primary, #6C5CE7) !important;
    font-size: 0.875rem !important;
    font-weight: 500 !important;
    text-decoration: none !important;
}
body.pagelayout-login .login-form-forgotpassword a:hover {
    text-decoration: underline !important;
}
/* Divider */
body.pagelayout-login .login-divider {
    margin: 1.15rem 0 !important;
    border-top: 1px solid #E2E8F0 !important;
    opacity: 0.8 !important;
}
/* Guest Access Section */
body.pagelayout-login .login-instructions {
    margin-top: 0.5rem !important;
    padding: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    text-align: center !important;
}
body.pagelayout-login .login-instructions p,
body.pagelayout-login .login-instructions-title {
    font-size: 0.875rem !important;
    color: #64748B !important;
    margin-bottom: 0.5rem !important;
    line-height: 1.4 !important;
}
body.pagelayout-login .login-instructions .btn,
body.pagelayout-login .login-instructions .btn-secondary {
    border-radius: 2rem !important;
    padding: 0.45rem 1.4rem !important;
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    background: #F1F5F9 !important;
    border: 1px solid #CBD5E1 !important;
    color: #334155 !important;
    transition: all 0.2s ease !important;
}
body.pagelayout-login .login-instructions .btn:hover {
    background: #E2E8F0 !important;
    color: #0F172A !important;
}
/* Cookies Notice */
body.pagelayout-login a[href*="cookies"],
body.pagelayout-login .login-container a {
    font-size: 0.8rem !important;
}
/* Alert / Login Errors */
body.pagelayout-login .alert {
    border-radius: 0.75rem !important;
    padding: 0.75rem 1rem !important;
    font-size: 0.9rem !important;
    margin-bottom: 1rem !important;
}
/* Dark Mode Toggle styling on Login */
.theedu-login-toggle-wrap {
    margin-top: 0.85rem;
    display: flex;
    justify-content: center;
}
body.pagelayout-login .theedu-darkmode-toggle {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid rgba(255, 255, 255, 0.5) !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2) !important;
    border-radius: 50% !important;
    width: 38px !important;
    height: 38px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #334155 !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
}
body.pagelayout-login .theedu-darkmode-toggle:hover {
    transform: scale(1.08) !important;
    background: #FFFFFF !important;
}

/* Dark Mode Overrides for Login */
[data-theme="dark"].pagelayout-login .theedu-login-card,
[data-theme="dark"] body.pagelayout-login .theedu-login-card {
    background: rgba(24, 32, 47, 0.96) !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08) inset !important;
    color: #F8FAFC !important;
}
[data-theme="dark"].pagelayout-login h2,
[data-theme="dark"] body.pagelayout-login h2,
[data-theme="dark"].pagelayout-login .login-heading {
    color: #F8FAFC !important;
}
[data-theme="dark"].pagelayout-login .form-control {
    background-color: #0F172A !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: #F8FAFC !important;
}
[data-theme="dark"].pagelayout-login .form-control:focus {
    background-color: #1E293B !important;
    border-color: var(--theedu-primary, #6C5CE7) !important;
}
[data-theme="dark"].pagelayout-login .login-divider {
    border-top-color: rgba(255, 255, 255, 0.12) !important;
}
[data-theme="dark"].pagelayout-login .login-instructions p,
[data-theme="dark"] body.pagelayout-login .login-instructions p {
    color: #94A3B8 !important;
}
[data-theme="dark"].pagelayout-login .login-instructions .btn {
    background: #1E293B !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: #E2E8F0 !important;
}
[data-theme="dark"].pagelayout-login .login-instructions .btn:hover {
    background: #334155 !important;
    color: #FFFFFF !important;
}
[data-theme="dark"].pagelayout-login .theedu-darkmode-toggle {
    background: rgba(30, 41, 59, 0.85) !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: #F8FAFC !important;
}
</style>

<body {{{ bodyattributes }}}>
<script>
    (function() {
        var saved = localStorage.getItem('theedu_theme_mode');
        var def = '{{theedu_darkmode.default}}' || 'auto';
        var mode = saved ? saved : (def === 'dark' ? 'dark' : (def === 'light' ? 'light' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')));
        document.documentElement.setAttribute('data-theme', mode);
        document.body.setAttribute('data-theme', mode);

        // Immediate click handler for dark mode button
        document.addEventListener('click', function(e) {
            var toggle = e.target.closest('.theedu-darkmode-toggle');
            if (!toggle) return;
            e.preventDefault();
            var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', current);
            document.body.setAttribute('data-theme', current);
            localStorage.setItem('theedu_theme_mode', current);
        });
    })();
</script>

<div id="page-wrapper">
    <div class="theedu-login-viewport">

        <div class="theedu-login-card">
            {{! Brand Logo inside the floating card }}
            {{#theedu_logos.top_left.enabled}}
                {{#theedu_logos.top_left.url}}
                    <div class="theedu-login-logo">
                        <img src="{{theedu_logos.top_left.url}}" alt="{{theedu_logos.top_left.alt}}" style="height: {{theedu_logos.top_left.height}}px;">
                    </div>
                {{/theedu_logos.top_left.url}}
                {{^theedu_logos.top_left.url}}
                    <div class="theedu-login-logo">
                        <h2 class="fw-bold mb-2" style="background: linear-gradient(135deg, var(--theedu-primary, #6C5CE7), var(--theedu-secondary, #00CEC9)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{{{ loginsitefullname }}}</h2>
                    </div>
                {{/theedu_logos.top_left.url}}
            {{/theedu_logos.top_left.enabled}}

            {{{ output.main_content }}}
        </div>

        <div class="theedu-login-toggle-wrap">
            {{> theme_theedu/dark_mode_toggle }}
        </div>

    </div>
</div>

{{{ output.standard_end_of_body_html }}}
</body>
</html>